  "cards": [
    { "dot": "cyan", "title": "入口连接", "items": ["外部客户端 → FastAPI：通过 HTTP /api/v1 上传、建任务、查进度和下载成品", "桌面用户 → pywebview + Vue：用户在界面选择音频、模型和参数", "Vue → Api Facade：通过 window.pywebview.api 调用 Python 方法", "FastAPI → Api Facade：HTTP 层复用同一个 Api，不重复实现业务"] },
    { "dot": "emerald", "title": "核心连接", "items": ["Api Facade → Application Services：把请求分发给 Work / Model / Conversion 等服务", "Application Services → 推理队列：创建任务并串行执行，控制单 GPU 显存峰值", "推理队列 → EngineRegistry：按 model.framework 选择具体推理框架", "Application Services → 本地用户数据：保存模型索引、作品状态、设置和日志"] },
    { "dot": "rose", "title": "模型连接", "items": ["Application Services → UVR：先分离人声与伴奏，必要时去混响", "EngineRegistry → Model Worker：启动隔离 Worker，由 Worker 加载 checkpoint", "Model Worker → 离线模型资产：读取模型、底模、F0 和声码器等资源", "Model Worker → FFmpeg：把转换人声交给后处理和最终混音；实际由业务服务编排"] },
    { "dot": "orange", "title": "可选与运行约束", "items": ["Application Services → Vocal Enhancement：可选的人声修复、增强和音频润色", "虚线表示可选能力或资源依赖，不是每次任务都必经", "普通任务通常一次启动 Worker；实时模式使用常驻 UVR 与 RVC/SeedVC Worker", "模型、作品、设置和临时文件位于可迁移的本地数据目录"] }
  ]
